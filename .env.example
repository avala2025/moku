# Railway Variables, რომლებიც MOKU-ს სჭირდება. მნიშვნელობები მხოლოდ Railway-ში ჩაწერე, აქ არა.
DATABASE_URL=        # Supabase, Session pooler მისამართი პაროლით
NODE_ENV=production
SESSION_SECRET=      # ნებისმიერი გრძელი შემთხვევითი ტექსტი, მინ. 24 სიმბოლო
ADMIN_EMAIL=         # პირველი ადმინის მეილი (იქმნება მხოლოდ ერთხელ, ცარიელ ბაზაზე)
ADMIN_PASSWORD=      # პირველი ადმინის პაროლი, მინ. 8 სიმბოლო
APP_URL=             # საიტის მისამართი, მაგ. https://moku-production-xxxx.up.railway.app
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=           # MOKU-ს Gmail მისამართი
SMTP_PASSWORD=       # Gmail-ის App password (16 სიმბოლო)
SUPABASE_URL=        # Supabase: Project Settings -> API -> Project URL (ფოტოების ატვირთვისთვის)
SUPABASE_SERVICE_ROLE_KEY=  # Supabase: API Keys -> Legacy API Keys -> service_role (საიდუმლო)
